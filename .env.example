# ==============================================================================
# AutoMail AI — Production & Vercel Environment Variables
# ==============================================================================
# When deploying to Vercel:
# Add these variables in: Vercel Dashboard -> Your Project -> Settings -> Environment Variables
# ==============================================================================

# 1. Executive Admin Console Credentials (Required to unlock Admin Monitor)
ADMIN_EMAIL=admin@automail.ai
ADMIN_PASSWORD=change_this_secure_admin_password_in_production

# 2. JWT Session Encryption Key (Required for authenticated user and admin tokens)
JWT_SECRET_KEY=automail_production_jwt_secret_key_change_me_to_random_hex_32_chars

# 3. Google Gemini AI API Key Pool (For categorization, briefings, drafting, and RAG chat)
# Add at least one Google Gemini API key:
GOOGLE_API_KEY=AIzaSyYourPrimaryGeminiApiKeyHere
# (Optional) Multi-key pool for enterprise rate-limit load balancing:
# GOOGLE_API_KEY_2=AIzaSyYourSecondGeminiApiKeyHere
# GOOGLE_API_KEY_3=AIzaSyYourThirdGeminiApiKeyHere

# 4. Google OAuth 2.0 Credentials (Optional, for "Sign in with Google")
# In Vercel, set GOOGLE_CALLBACK_URL to: https://<your-vercel-domain>.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-domain.vercel.app/api/auth/google/callback

# 5. Optional Production PostgreSQL & Redis Storage (Defaults to local /tmp in serverless)
# DATABASE_URL=postgresql+asyncpg://user:password@neon.tech/automail
# REDIS_URL=rediss://default:password@upstash.io:6379
